# Notion internal integration token — create at https://www.notion.so/my-integrations,
# then open your Target List database in Notion, click "..." > Connections,
# and add the integration so it can read/write the database.
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxxxxxx

# The Target List database ID — copy from its Notion URL:
# https://www.notion.so/yourworkspace/<THIS_PART_32_CHARS>?v=...
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The Job Postings database ID, same way — copy from its Notion URL.
JOB_POSTINGS_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Only needed for the ATS auto-search fallback (when a company's ATS can't
# be guessed from a known URL pattern). Create at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
